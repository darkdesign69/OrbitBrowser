<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/source_code_pro</item>
        <item name="alertDialogTheme">@style/OrbitAlert</item>
        <item name="colorPrimary">@color/bg</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent_dark</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorControlHighlight">@color/pressed</item>
    </style>

    <style name="FullDialog" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/source_code_pro</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowAnimationStyle">@style/SheetAnim</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
